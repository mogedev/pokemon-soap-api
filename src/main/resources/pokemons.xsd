<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://www.bankaya.com/pokemon-soap-api"
           targetNamespace="http://www.bankaya.com/pokemon-soap-api"
           elementFormDefault="qualified">

    <!-- Pokemon request definition -->
    <xs:element name="getPokemonRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="pokemonName" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Pokemon response definition -->
    <xs:element name="getPokemonResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="pokemon" type="tns:pokemon"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="pokemon">
        <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="base_experience" type="xs:int"/>
            <xs:element name="location_area_encounters" type="xs:string"/>
            <xs:element name="abilities" type="tns:abilities"/>
            <xs:element name="held_items" type="tns:heldItems"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="abilities">
        <xs:sequence>
            <xs:element name="ability" type="tns:abilityType" maxOccurs="unbounded" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="abilityType">
        <xs:sequence>
            <xs:element name="ability" type="tns:abilityDetailsType"/>
            <xs:element name="is_hidden" type="xs:boolean"/>
            <xs:element name="slot" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="abilityDetailsType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="url" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="heldItems">
        <xs:sequence>
            <xs:element name="heldItem" type="tns:heldItemType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="heldItemType">
        <xs:sequence>
            <xs:element name="item" type="tns:itemType"/>
            <xs:element name="version_details" type="tns:versionDetailsListType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="itemType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="url" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="versionDetailsListType">
        <xs:sequence>
            <xs:element name="versionDetail" type="tns:versionDetailType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="versionDetailType">
        <xs:sequence>
            <xs:element name="rarity" type="xs:int"/>
            <xs:element name="version" type="tns:versionType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="versionType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="url" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>